# relays the browser dials first (src/relay.js). For `npm run dev` start one with `npm run relay`
# and put its WebSocket address here (GET http://127.0.0.1:9090/multiaddrs lists it).
VITE_SEED_NODES_DEV=/ip4/127.0.0.1/tcp/9092/ws/p2p/<peer id of your local relay>
VITE_SEED_NODES=/dns4/ipfs.le-space.de/tcp/443/wss/p2p/12D3KooWAJjbRkp8FPF5MKgMU53aUTxWkqvDrs4zc1VMbwRwfsbE,/ip4/159.69.119.82/udp/9090/webrtc-direct/certhash/uEiAIh0DoA5Qk2xTpc_j58KZMvww9CQzN6UNgsJ-DTuM6XQ/p2p/12D3KooWF5fGyE4VeXMhSGd9rCwckyxCVkA6xfoyFJG9DWJis62v
VITE_P2P_PUPSUB=dcontact._peer-discovery._p2p._pubsub
VITE_P2P_PUPSUB_DEV=dev-dcontact._peer-discovery._p2p._pubsub
# seed phrase for tests/MyDevicesAutoSync.spec.js (defaults to the BIP39 test vector)
SEED_TEST=

