{
	"name": "decontact",
	"version": "0.5.0",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build ",
		"build:fixed": "npm run build && node ipfs_fixes/inject_base.cjs && node ipfs_fixes/inject_base_in_singletons_file.cjs && node ipfs_fixes/inject_base_in_paths_file.cjs && node ipfs_fixes/relativize_pages.cjs && node ipfs_fixes/relativize_js.cjs",
		"preview": "vite preview",
		"relay": "node src/relay.js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"test": "npm run test:unit && npm run test:e2e",
		"test:e2e": "playwright test",
		"test:e2e:manual": "playwright test --headed --debug --trace on",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest --run"
	},
	"devDependencies": {
		"@playwright/test": "1.61.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@types/eslint": "8.56.0",
		"carbon-components-svelte": "^0.82.7",
		"dotenv": "^16.4.1",
		"eslint": "^8.56.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.46.1",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.1.2",
		"svelte": "^5.59.2",
		"svelte-check": "^4.7.8",
		"svelte-time": "^0.8.2",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.2"
	},
	"type": "module",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"packageManager": "pnpm@10.33.0",
	"dependencies": {
		"@chainsafe/libp2p-noise": "17.0.0",
		"@chainsafe/libp2p-yamux": "8.0.1",
		"@helia/bitswap": "4.0.20",
		"@helia/libp2p": "2.1.5",
		"@ipld/dag-cbor": "9.2.5",
		"@le-space/aleph-bootstrap": "0.12.15",
		"@le-space/orbitdb-access-controller-decontact": "workspace:*",
		"@libp2p/autonat": "3.0.33",
		"@libp2p/bootstrap": "12.0.37",
		"@libp2p/circuit-relay-v2": "4.2.18",
		"@libp2p/crypto": "5.2.0",
		"@libp2p/dcutr": "3.0.33",
		"@libp2p/gossipsub": "17.2.2",
		"@libp2p/identify": "4.1.19",
		"@libp2p/interface": "3.4.0",
		"@libp2p/ping": "3.1.18",
		"@libp2p/pubsub-peer-discovery": "12.0.0",
		"@libp2p/webrtc": "7.0.3",
		"@libp2p/websockets": "10.1.26",
		"@multiformats/multiaddr": "13.0.3",
		"@orbitdb/core": "4.0.0",
		"@orbitdb/identity-provider-did": "1.0.2",
		"@orbitdb/identity-provider-ethereum": "1.0.2",
		"bip39": "^3.1.0",
		"blockstore-level": "4.0.1",
		"carbon-icons-svelte": "^12.4.2",
		"datastore-level": "13.0.1",
		"dotenv": "^16.4.1",
		"hdkey": "^2.1.0",
		"helia": "7.1.16",
		"key-did-provider-ed25519": "^4.0.2",
		"key-did-resolver": "^4.0.0",
		"libp2p": "3.5.2",
		"multiformats": "14.0.7",
		"orbitdb-relay": "0.10.11",
		"qrcode-generator": "^1.4.4",
		"svelte-qrcode": "^1.0.0",
		"vite-plugin-node-polyfills": "^0.28.0"
	}
}
